{
  "name": "work-support",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "typecheck": "pnpm -r --parallel run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r run test",
    "harness:check": "node scripts/harness-check.mjs && node scripts/gen-db-docs.mjs --check && node --test \".claude/hooks/*.test.mjs\"",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm harness:check",
    "db:types": "bash packages/shared/supabase-gen-types.sh",
    "db:docs": "node scripts/gen-db-docs.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "supabase": "^2.120.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.44.1"
  },
  "packageManager": "pnpm@10.17.1+sha512.17c560fca4867ae9473a3899ad84a88334914f379be46d455cbf92e5cf4b39d34985d452d2583baf19967fa76cb5c17bc9e245529d0b98745721aa7200ecaf7a"
}
