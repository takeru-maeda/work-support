{
  "permissions": {
    "deny": [
      "Bash(*wrangler deploy*)",
      "Bash(*wrangler secret*)",
      "Bash(*wrangler rollback*)",
      "Bash(*wrangler versions deploy*)",
      "Bash(*run deploy*)",
      "Bash(*shadcn* apply*)",
      "Bash(*shadcn* init*)",
      "Bash(*shadcn*--overwrite*)",
      "Bash(*supabase db push*)",
      "Bash(npm install*)",
      "Bash(npm i *)",
      "Bash(*.dev.vars*)",
      "Bash(*cat *.env*)",
      "Read(**/.dev.vars)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "mcp__supabase__execute_sql",
      "mcp__supabase__apply_migration"
    ],
    "ask": [
      "Bash(git add*)",
      "Bash(git mv*)",
      "Bash(git rm*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(*shadcn*)",
      "Bash(pnpm add*)",
      "Bash(pnpm * add *)",
      "Bash(pnpm dlx*)",
      "Bash(npx *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/spec-gate.mjs\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.mjs\""
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/record-bash-changes.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-on-edit.mjs\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/record-bash-changes.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-gate.mjs\"",
            "timeout": 300
          }
        ]
      }
    ]
  },
  "skillOverrides": {
    "supabase": "name-only",
    "supabase-postgres-best-practices": "name-only",
    "hono": "name-only",
    "shadcn": "name-only",
    "vercel-react-best-practices": "name-only",
    "playwright-best-practices": "name-only"
  }
}